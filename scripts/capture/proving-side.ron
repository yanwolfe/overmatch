// A capture plan (`dev_capture::plan::CapturePlan`) for the proving ground's passes (game state
// only; `scripts/perf/collapse.md`): the pass seen side-on, for `collapse.sh --ram --clip`, whose
// client runs it in the run's folder on a hidden window.
(
    frames: (
        // The run folder's frames/side-<time>s.png.
        out: "frames/side.png",
        // Resolution: eight frames a second for ten seconds, which holds a 10 km/h pass from its
        // lead to the hull's rear clearing a wall.
        at: [
            0.0, 0.125, 0.25, 0.375, 0.5, 0.625, 0.75, 0.875,
            1.0, 1.125, 1.25, 1.375, 1.5, 1.625, 1.75, 1.875,
            2.0, 2.125, 2.25, 2.375, 2.5, 2.625, 2.75, 2.875,
            3.0, 3.125, 3.25, 3.375, 3.5, 3.625, 3.75, 3.875,
            4.0, 4.125, 4.25, 4.375, 4.5, 4.625, 4.75, 4.875,
            5.0, 5.125, 5.25, 5.375, 5.5, 5.625, 5.75, 5.875,
            6.0, 6.125, 6.25, 6.375, 6.5, 6.625, 6.75, 6.875,
            7.0, 7.125, 7.25, 7.375, 7.5, 7.625, 7.75, 7.875,
            8.0, 8.125, 8.25, 8.375, 8.5, 8.625, 8.75, 8.875,
            9.0, 9.125, 9.25, 9.375, 9.5, 9.625, 9.75, 9.875,
            10.0,
        ],
        // Resolution: bounded evidence; the client renders on the server's machine.
        size: (1280, 720),
        scale_factor: 1.0,
        ui: false,
        gizmos: false,
        // Taste: clip framing, metres from the tank's root in the approach's frame: square off its
        // right side at about the wall's mid-height, far enough to hold the hull and a wall's
        // thickness of travel either side.
        camera: Follow(offset: (16.0, 2.5, 0.0)),
        // Taste: the first frame shows the hull a second and a half short of the wall.
        lead_s: 1.5,
    ),
)
