// `wall_brick.wall.ron`'s wall as an L: two 5 m runs meeting square, one along `+X` and its return
// along `+Z`, coursed into each other at the corner by the walls' mortar as the village house's
// corners are. The origin is the corner's inside vertex, so a pass laid through it on the diagonal
// from `(+X, +Z)` drives into the inside. Part, foot and top as that file's.
Wall(
    id: "wall_brick_corner",
    foundation_y_m: -0.45,
    foundation_attachment: "mortared",
    parts: {
        "leaf": (
            material: "Brick",
            surface_frame: Upright,
            cut: Planar((
                pitch_m: (0.21, Resolution("the village house's wall cell, so a pass through this wall reads against a pass through that house")),
                keep_share: (0.82, Taste("masonry break look, the village house's")),
            )),
        ),
    },
    runs: [
        (name: "run", part: "leaf", component: "run", from: (-0.25, -0.125), to: (5.0, -0.125), thickness_m: 0.25, y_m: (-0.45, 2.7)),
        (name: "return", part: "leaf", component: "return", from: (-0.125, 0.0), to: (-0.125, 5.0), thickness_m: 0.25, y_m: (-0.45, 2.7)),
    ],
    joins: [(parts: ("leaf", "leaf"), by: "mortared")],
)
