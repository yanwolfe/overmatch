            cut: Planar((
                pitch_m: (0.55, Resolution("the village hall's wall cell, 2.6 times the reference wall's across: the coarse arm of the cut-independence check")),
                keep_share: (0.82, Taste("masonry break look, the village house's")),
            )),
        ),
    },
    runs: [
        (name: "leaf", part: "leaf", component: "leaf", from: (-4.0, 0.0), to: (4.0, 0.0), thickness_m: 0.25, y_m: (-0.45, 2.7)),
    ],
